# KMD Validator — Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit real keys to the repository.

# OpenRouter API key (required for LLM-based validation)
OPENROUTER_API_KEY=

# Pinecone API key (required for RAG search / indexing)
PINECONE_API_KEY=

# Pinecone index name (default: kmd-knowledge)
# PINECONE_INDEX=kmd-knowledge

# Pinecone host (default: kmd-knowledge-b0hkvr1.svc.aped-4627-b74a.pinecone.io)
# PINECONE_HOST=

# API key for authenticating requests to KMD backend (auto-generated if not set)
KMD_API_KEY=

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=
